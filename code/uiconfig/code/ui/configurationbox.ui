<interface domain="code">
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkBox" id="ConfigurationBox">
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <property name="spacing">6</property>
    <child>
      <object class="GtkComboBoxText" id="configuration">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="hexpand">False</property>
        <property name="valign">center</property>
        <property name="width-request">110</property>
        <child internal-child="accessible">
          <object class="AtkObject" id="configuration-atkobject">
            <property name="AtkObject::accessible-name" translatable="yes" context="configurationbox|configuration|accessible_name">Solution Configuration</property>
          </object>
        </child>
      </object>
      <packing>
        <property name="expand">False</property>
        <property name="fill">True</property>
        <property name="position">0</property>
      </packing>
    </child>
  </object>
</interface>
