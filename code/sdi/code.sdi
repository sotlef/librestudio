shell code_Shell
{
    import CodeView;

    SID_NEWDOC
    [
        ExecMethod  = Execute;
        StateMethod = GetState;
    ]

    SID_SAVEDOC
    [
        ExecMethod  = Execute;
        StateMethod = GetState;
    ]

    SID_CODE_OPENFOLDER
    [
        ExecMethod = Execute;
    ]

    SID_CODE_OPENPROJECT
    [
        ExecMethod = Execute;
    ]

    SID_CODE_CONFIGURATION
    [
        StateMethod = GetState;
    ]

    SID_CODE_RECENTPROJECTS
    [
        StateMethod = GetState;
    ]

    SID_CODE_BUILD
    [
        ExecMethod = Execute;
        StateMethod = GetState;
    ]

    SID_CODE_REBUILD
    [
        ExecMethod = Execute;
        StateMethod = GetState;
    ]

    SID_CODE_CLEAN
    [
        ExecMethod = Execute;
        StateMethod = GetState;
    ]

    SID_CODE_OPTIONS
    [
        ExecMethod = Execute;
    ]

    SID_CODE_FINDINFILES
    [
        ExecMethod = Execute;
    ]

    SID_CODE_REPLACEINFILES
    [
        ExecMethod = Execute;
    ]

    SID_CODE_MODIFYFIND
    [
        ExecMethod = Execute;
    ]

    SID_COPY
    [
        ExecMethod = Execute;
    ]

    SID_CUT
    [
        ExecMethod = Execute;
    ]

    SID_PASTE
    [
        ExecMethod = Execute;
    ]

    SID_UNDO
    [
        ExecMethod = Execute;
    ]

    SID_REDO
    [
        ExecMethod = Execute;
    ]

    SID_SELECTALL
    [
        ExecMethod = Execute;
    ]

    SID_CODE_GOTODEFINITION
    [
        ExecMethod = Execute;
    ]

    SID_CODE_GOTOSYMBOL
    [
        ExecMethod = Execute;
    ]

    SID_CODE_CANCELBUILD
    [
        ExecMethod = Execute;
        StateMethod = GetState;
    ]

    SID_CODE_SAVEALL
    [
        ExecMethod = Execute;
    ]

    SID_CODE_STATUS_TASKS
    [
        StateMethod = GetState;
    ]

    SID_CODE_STATUS_READY
    [
        StateMethod = GetState;
    ]

    SID_CODE_STATUS_VCS
    [
        StateMethod = GetState;
    ]

    SID_CODE_STARTUP
    [
        StateMethod = GetState;
    ]

    SID_CODE_START_DEBUGGING
    [
        ExecMethod = Execute;
        StateMethod = GetState;
    ]

    SID_CODE_START_WITHOUT_DEBUGGING
    [
        ExecMethod = Execute;
        StateMethod = GetState;
    ]
}

// A plain SfxChildWindow show/hide toggle, handled generically by
// SfxViewFrame::ChildWindowExecute/ChildWindowState (the same mechanism
// SID_SIDEBAR itself goes through) -- no ExecMethod/StateMethod of our own,
// matching starmath.sdi's own CommandWindow/SID_CMDBOXWINDOW entry.
SfxVoidItem ShowOutput SID_CODE_OUTPUT
()
[
    AutoUpdate = FALSE,
    FastCall = FALSE,
    ReadOnlyDoc = FALSE,
    Toggle = FALSE,
    Container = FALSE,
    RecordAbsolute = FALSE,
    RecordPerSet;

    AccelConfig = FALSE,
    MenuConfig = FALSE,
    ToolBoxConfig = FALSE,
    GroupId = SfxGroupId::View;
]
