interface CodeDocument
{
}

shell code_DocShell
{
    import CodeDocument;
}

interface CodeView
{
}

// The status bar's background-tasks bubble button (leftmost item); its
// SfxStatusBarControl (code/source/tasksstatusbarcontrol.cxx) paints the
// bubble and pops the "No background tasks running." popover itself, so
// state is only needed to keep the item enabled.
SfxVoidItem CodeBackgroundTasks SID_CODE_STATUS_TASKS

[
    AutoUpdate = FALSE,
    FastCall = FALSE,
    ReadOnlyDoc = TRUE,
    Toggle = FALSE,
    Container = FALSE,
    RecordAbsolute = FALSE,
    RecordPerSet;

    AccelConfig = FALSE,
    MenuConfig = FALSE,
    ToolBoxConfig = FALSE,
    GroupId = SfxGroupId::View;
]

// The status bar's "Ready" text next to the bubble button: a plain
// SfxStringItem state (shell GetState), displayed by the default
// SfxStatusBarControl -- same shape as sfx.sdi's StatusGetTitle.
SfxStringItem CodeStatusReady SID_CODE_STATUS_READY

[
    AutoUpdate = FALSE,
    FastCall = FALSE,
    ReadOnlyDoc = TRUE,
    Toggle = FALSE,
    Container = FALSE,
    RecordAbsolute = FALSE,
    RecordPerSet;

    AccelConfig = FALSE,
    MenuConfig = FALSE,
    ToolBoxConfig = FALSE,
    GroupId = SfxGroupId::View;
]

// File > Open Folder: asks for a directory and opens it as a project.
SfxVoidItem CodeOpenFolder SID_CODE_OPENFOLDER
()
[
    AutoUpdate = FALSE,
    FastCall = FALSE,
    ReadOnlyDoc = TRUE,
    Toggle = FALSE,
    Container = FALSE,
    RecordAbsolute = FALSE,
    RecordPerSet;

    AccelConfig = TRUE,
    MenuConfig = TRUE,
    ToolBoxConfig = TRUE,
    GroupId = SfxGroupId::Application;
]

// File > Save All: saves every document with unsaved changes.
SfxVoidItem CodeSaveAll SID_CODE_SAVEALL
()
[
    AutoUpdate = FALSE,
    FastCall = FALSE,
    ReadOnlyDoc = TRUE,
    Toggle = FALSE,
    Container = FALSE,
    RecordAbsolute = FALSE,
    RecordPerSet;

    AccelConfig = TRUE,
    MenuConfig = TRUE,
    ToolBoxConfig = TRUE,
    GroupId = SfxGroupId::Application;
]

shell code_Shell
{
    import CodeView;

    SID_NEWDOC
    [
        ExecMethod  = Execute;
        StateMethod = GetState;
    ]

    SID_SAVEDOC
    [
        ExecMethod  = Execute;
        StateMethod = GetState;
    ]

    SID_CODE_OPENFOLDER
    [
        ExecMethod = Execute;
    ]

    SID_CODE_SAVEALL
    [
        ExecMethod = Execute;
    ]

    SID_CODE_STATUS_TASKS
    [
        StateMethod = GetState;
    ]

    SID_CODE_STATUS_READY
    [
        StateMethod = GetState;
    ]
}

// A plain SfxChildWindow show/hide toggle, handled generically by
// SfxViewFrame::ChildWindowExecute/ChildWindowState (the same mechanism
// SID_SIDEBAR itself goes through) -- no ExecMethod/StateMethod of our own,
// matching starmath.sdi's own CommandWindow/SID_CMDBOXWINDOW entry.
SfxVoidItem ShowOutput SID_CODE_OUTPUT
()
[
    AutoUpdate = FALSE,
    FastCall = FALSE,
    ReadOnlyDoc = FALSE,
    Toggle = FALSE,
    Container = FALSE,
    RecordAbsolute = FALSE,
    RecordPerSet;

    AccelConfig = FALSE,
    MenuConfig = FALSE,
    ToolBoxConfig = FALSE,
    GroupId = SfxGroupId::View;
]
