// The status bar's background-tasks bubble button (leftmost item); its
// SfxStatusBarControl (code/source/tasksstatusbarcontrol.cxx) paints the
// bubble and pops the "No background tasks running." popover itself, so
// state is only needed to keep the item enabled.
SfxVoidItem CodeBackgroundTasks SID_CODE_STATUS_TASKS

[
    AutoUpdate = FALSE,
    FastCall = FALSE,
    ReadOnlyDoc = TRUE,
    Toggle = FALSE,
    Container = FALSE,
    RecordAbsolute = FALSE,
    RecordPerSet;

    AccelConfig = FALSE,
    MenuConfig = FALSE,
    ToolBoxConfig = FALSE,
    GroupId = SfxGroupId::View;
]

// The status bar's "Ready" text next to the bubble button: a plain
// SfxStringItem state (shell GetState), displayed by the default
// SfxStatusBarControl -- same shape as sfx.sdi's StatusGetTitle.
SfxStringItem CodeStatusReady SID_CODE_STATUS_READY

[
    AutoUpdate = FALSE,
    FastCall = FALSE,
    ReadOnlyDoc = TRUE,
    Toggle = FALSE,
    Container = FALSE,
    RecordAbsolute = FALSE,
    RecordPerSet;

    AccelConfig = FALSE,
    MenuConfig = FALSE,
    ToolBoxConfig = FALSE,
    GroupId = SfxGroupId::View;
]

// The status bar's version control item: what the repository of the active
// project shows of itself (shell GetState), drawn by VcsStatusBarControl.
SfxStringItem CodeVcsBranch SID_CODE_STATUS_VCS

[
    AutoUpdate = FALSE,
    FastCall = FALSE,
    ReadOnlyDoc = TRUE,
    Toggle = FALSE,
    Container = FALSE,
