/*
Whether the cairo canvas surface backend is built.  Upstream defines this
whenever cairo is available and --disable-cairo-canvas was not given, so it is
on by default; cairo is linked into libvcl here through USE_HEADLESS_CODE, and
the flag is on to match.  It guards virtual methods on SalGraphics that the
back ends override — the implementations live in the toolkit plug-ins, which
this build does not have yet, so for now nothing overrides them.
*/

#ifndef CONFIG_CAIRO_CANVAS_H
#define CONFIG_CAIRO_CANVAS_H

#define ENABLE_CAIRO_CANVAS @ENABLE_CAIRO_CANVAS@

#endif
