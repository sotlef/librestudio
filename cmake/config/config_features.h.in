/*
Features that can be switched on and off at configure time.

Everything is 0 unless the corresponding piece of the suite is built.  The UNO
core only ever looks at MACOSX_SANDBOX, BACKTRACE and BREAKPAD; the rest are
defined so that "#if HAVE_FEATURE_x" and "#ifdef HAVE_FEATURE_x" agree.
*/

#ifndef CONFIG_FEATURES_H
#define CONFIG_FEATURES_H

#define HAVE_FEATURE_AFDKO 0
#define HAVE_FEATURE_AVMEDIA 0
#define HAVE_FEATURE_DBCONNECTIVITY 0
#define HAVE_FEATURE_SCRIPTING 0
#define HAVE_FEATURE_MULTIUSER_ENVIRONMENT @HAVE_FEATURE_MULTIUSER_ENVIRONMENT@
#define HAVE_FEATURE_AVAHI 0
#define HAVE_FEATURE_MACOSX_SANDBOX 0
#define HAVE_FEATURE_READONLY_INSTALLSET 0
#define HAVE_FEATURE_BREAKPAD 0
#define HAVE_FEATURE_BACKTRACE @HAVE_FEATURE_BACKTRACE@
#define HAVE_FEATURE_OPENGL @HAVE_FEATURE_OPENGL@
#define HAVE_FEATURE_SKIA 0
#define HAVE_FEATURE_UI @HAVE_FEATURE_UI@
#define HAVE_FEATURE_PDFIMPORT 0
#define HAVE_FEATURE_POPPLER 0
#define HAVE_FEATURE_UPDATE_MAR 0
#define HAVE_FEATURE_ANDROID_LOK 0
#define HAVE_FEATURE_XMLHELP 0
#define HAVE_FEATURE_PAGEIN 0
#define HAVE_FEATURE_JUMBO_SHEETS 0

#define HAVE_FT_FACE_GETCHARVARIANTINDEX 0
#define HAVE_EXPORT_VALIDATION 0

#endif
