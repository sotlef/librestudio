/*
Build options that affect compilation.

We never merge libraries, so ENABLE_MERGELIBS stays 0 and the UNLESS_MERGELIBS /
IF_MERGELIBS wrappers keep their default meaning.
*/

#ifndef CONFIG_OPTIONS_H
#define CONFIG_OPTIONS_H

#define ENABLE_MERGELIBS 0
#define ENABLE_MERGELIBS_MORE 0
#define ENABLE_PCH 0
#define ENABLE_RUNTIME_OPTIMIZATIONS @ENABLE_RUNTIME_OPTIMIZATIONS@

#if ENABLE_MERGELIBS
#define UNLESS_MERGELIBS(x)
#else
#define UNLESS_MERGELIBS(x) x
#endif

#if ENABLE_MERGELIBS
#define IF_MERGELIBS(x) x
#else
#define IF_MERGELIBS(x)
#endif

#if ENABLE_MERGELIBS_MORE
#define UNLESS_MERGELIBS_MORE(x)
#else
#define UNLESS_MERGELIBS_MORE(x) x
#endif

#if ENABLE_MERGELIBS_MORE
#define IF_MERGELIBS_MORE(x) x
#else
#define IF_MERGELIBS_MORE(x)
#endif

#endif
