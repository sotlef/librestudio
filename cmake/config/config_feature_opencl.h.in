/*
Whether the OpenCL-backed implementations are built.  Upstream turns them on
for a BUILD_TYPE of OPENCL, which this DESKTOP build never has -- but
ENABLE_OPENCL (cmake/LibreStudioConfigHeaders.cmake) tracks whether
opencl/clew are actually built here regardless, since both are real,
locally-buildable targets on this platform.
*/

#ifndef CONFIG_FEATURE_OPENCL_H
#define CONFIG_FEATURE_OPENCL_H

#define HAVE_FEATURE_OPENCL @HAVE_FEATURE_OPENCL@

#endif
