/*
Whether the Common Print Dialog Backends are used for printing.  Upstream makes
it --enable-cpdb, off by default; this build has no option for it and leaves it
off, which means printing goes through the print dialog vcl implements itself.
*/

#pragma once

#define ENABLE_CPDB @ENABLE_CPDB@
