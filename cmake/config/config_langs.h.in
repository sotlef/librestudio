/*
Upstream's --with-lang restricts the UI languages a build ships translations
for; WITH_LANG holds that list and an empty string means "no restriction",
which is what WITH_LOCALE_ALL in config_locales.h already says for this build.
*/

#ifndef CONFIG_LANGS_H
#define CONFIG_LANGS_H

#define WITH_LANG ""

#endif
