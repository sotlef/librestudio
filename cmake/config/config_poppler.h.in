/*
Settings for poppler header file detection.

Transcribed verbatim from config_host/config_poppler.h.in, which hardcodes
this to 0 unconditionally upstream too (not an autoconf @VAR@ substitution)
-- this ENABLE_PDFIMPORT macro is dead code upstream itself, unrelated to
whether sdext/Executable_xpdfimport.mk's xpdfimport binary is built (see
sdext/CMakeLists.txt's own ENABLE_POPPLER gate for that).
*/

#ifndef CONFIG_POPPLER_H
#define CONFIG_POPPLER_H

#define ENABLE_PDFIMPORT 0

#endif
