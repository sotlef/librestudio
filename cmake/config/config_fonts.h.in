/*
Whether the third-party fonts shipped alongside the office are included.
Upstream asks --with-fonts and answers yes by default, which is what this
build does too: the packages are what make documents that name a font the
system does not have look the way their author saw them.
*/

#ifndef CONFIG_FONTS_H
#define CONFIG_FONTS_H

#define HAVE_MORE_FONTS @HAVE_MORE_FONTS@

#endif
