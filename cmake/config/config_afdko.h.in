/*
Settings for the AFDKO font tools, which upstream uses when BUILD_TYPE includes
AFDKO.  This build is DESKTOP and does not use the programs; the names are here
because the header has to define them either way.
*/

#ifndef CONFIG_AFDKO_H
#define CONFIG_AFDKO_H

#define USE_AFDKO_PROGRAMS @USE_AFDKO_PROGRAMS@
#define TX "tx"
#define MAKEOTF "makeotf"
#define MERGEFONTS "mergefonts"

#endif
