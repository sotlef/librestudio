/*
Whether Embedded OpenType fonts are supported.  Upstream makes it --disable-eot
and enables it by default for anything that is not a fuzzer build, then checks
that libeot is present — which it is here.
*/

#ifndef CONFIG_EOT_H
#define CONFIG_EOT_H

#define ENABLE_EOT @ENABLE_EOT@

#endif
