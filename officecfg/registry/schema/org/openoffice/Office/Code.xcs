<!DOCTYPE oor:component-schema SYSTEM "../../../../component-schema.dtd">
<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" oor:name="Code" oor:package="org.openoffice.Office" xml:lang="en-US">
  <info>
    <desc>Contains the user's preferences for the Code application (Tools > Options).</desc>
  </info>
  <component>
    <group oor:name="Editor">
      <info>
        <desc>The text editor.</desc>
      </info>
      <prop oor:name="FontName" oor:type="xs:string" oor:nillable="false">
        <info>
          <desc>The family of the editor's font; it should be a fixed-pitch one.</desc>
        </info>
        <value>monospace</value>
      </prop>
      <prop oor:name="FontSize" oor:type="xs:int" oor:nillable="false">
        <info>
          <desc>The height of the editor's font in points; 0 is the size of the system's field font.</desc>
        </info>
        <constraints>
          <minInclusive oor:value="0"/>
          <maxInclusive oor:value="72"/>
        </constraints>
        <value>0</value>
      </prop>
      <prop oor:name="TabWidth" oor:type="xs:int" oor:nillable="false">
        <info>
          <desc>The distance between two tab stops, in characters.</desc>
        </info>
        <constraints>
          <minInclusive oor:value="1"/>
          <maxInclusive oor:value="16"/>
        </constraints>
        <value>4</value>
      </prop>
      <prop oor:name="InsertSpaces" oor:type="xs:boolean" oor:nillable="false">
        <info>
          <desc>Whether the Tab key inserts spaces up to the next tab stop instead of a tab character.</desc>
        </info>
        <value>true</value>
      </prop>
      <prop oor:name="LineNumbers" oor:type="xs:boolean" oor:nillable="false">
        <info>
          <desc>Whether the line numbers are shown on the left of the text.</desc>
        </info>
        <value>true</value>
      </prop>
    </group>
    <group oor:name="Find">
      <info>
        <desc>The Find and Replace dialog (Find in Files, Replace in Files).</desc>
      </info>
      <prop oor:name="FindHistory" oor:type="oor:string-list">
        <info>
          <desc>The texts searched for earlier, the latest first.</desc>
        </info>
        <value/>
      </prop>
      <prop oor:name="ReplaceHistory" oor:type="oor:string-list">
        <info>
          <desc>The replacement texts used earlier, the latest first.</desc>
        </info>
        <value/>
      </prop>
      <prop oor:name="FileTypesHistory" oor:type="oor:string-list">
        <info>
          <desc>The file type masks used earlier, the latest first.</desc>
        </info>
        <value/>
      </prop>
      <prop oor:name="MatchCase" oor:type="xs:boolean" oor:nillable="false">
        <info>
          <desc>Whether the search tells upper and lower case apart.</desc>
        </info>
        <value>false</value>
      </prop>
      <prop oor:name="MatchWholeWord" oor:type="xs:boolean" oor:nillable="false">
        <info>
          <desc>Whether the search finds whole words only.</desc>
        </info>
        <value>false</value>
      </prop>
      <prop oor:name="UseRegex" oor:type="xs:boolean" oor:nillable="false">
        <info>
          <desc>Whether the text searched for is a regular expression.</desc>
        </info>
        <value>false</value>
      </prop>
      <prop oor:name="PreserveCase" oor:type="xs:boolean" oor:nillable="false">
        <info>
          <desc>Whether a replacement takes over the upper or lower case of the text it replaces.</desc>
        </info>
        <value>false</value>
      </prop>
      <prop oor:name="IncludeExternal" oor:type="xs:boolean" oor:nillable="false">
        <info>
          <desc>Whether the search includes external items.</desc>
        </info>
        <value>false</value>
      </prop>
      <prop oor:name="IncludeMisc" oor:type="xs:boolean" oor:nillable="false">
        <info>
          <desc>Whether the search includes miscellaneous files.</desc>
        </info>
        <value>false</value>
      </prop>
      <prop oor:name="IncludeSubfolders" oor:type="xs:boolean" oor:nillable="false">
        <info>
          <desc>Whether the search of a directory includes its subfolders.</desc>
        </info>
        <value>true</value>
      </prop>
      <prop oor:name="SelectionScope" oor:type="xs:int" oor:nillable="false">
        <info>
          <desc>The part of the current document to search: 0 entire document, 1 current selection, 2 current block.</desc>
        </info>
        <value>0</value>
      </prop>
      <prop oor:name="LookIn" oor:type="xs:string" oor:nillable="false">
        <info>
          <desc>The scope of the search, as the dialog shows it; empty is the entire solution.</desc>
        </info>
        <value></value>
      </prop>
      <prop oor:name="FileTypes" oor:type="xs:string" oor:nillable="false">
        <info>
          <desc>The mask of the files to search, the masks separated by semicolons.</desc>
        </info>
        <value>*.*</value>
      </prop>
    </group>
  </component>
</oor:component-schema>
