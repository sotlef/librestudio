module com { module sun { module star { module code { module syntax {

/** What a parser had to say about the code: an error, a warning, a note.  A
    parse that fails entirely is one FATAL diagnostic and ParseResult::Succeeded
    FALSE; a parser never throws for what is wrong with the code. */
struct SyntaxDiagnostic
{
    ::com::sun::star::code::core::Severity Level;
    string Message;
    /** URL of the file concerned -- an include, not necessarily the file that
        was parsed; empty if there is none */
    string Url;
    ::com::sun::star::code::core::Position Location;
};

}; }; }; }; };

