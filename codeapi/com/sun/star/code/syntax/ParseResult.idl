module com { module sun { module star { module code { module syntax {

/** One parse of one file. */
struct ParseResult
{
    /** the whole file, of kind TRANSLATION_UNIT; its Children are empty when
        Succeeded is FALSE */
    ::com::sun::star::code::syntax::SyntaxNode Root;
    sequence< ::com::sun::star::code::syntax::SyntaxDiagnostic > Diagnostics;
    /** TRUE if the parser produced a tree.  Code with errors still parses: the
        errors are in Diagnostics and the tree is what the parser made of it. */
    boolean Succeeded;
};

}; }; }; }; };

