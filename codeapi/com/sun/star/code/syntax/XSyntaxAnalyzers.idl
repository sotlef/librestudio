module com { module sun { module star { module code { module syntax {

/** The analyzers that are registered, nothing more: parsing is on demand and
    the registry keeps no results.  A second registration under a name replaces
    the first. */
interface XSyntaxAnalyzers
{
    void registerAnalyzer( [in] ::com::sun::star::code::syntax::XSyntaxAnalyzer Analyzer );
    void unregisterAnalyzer( [in] string Name );
    sequence< ::com::sun::star::code::syntax::XSyntaxAnalyzer > getAnalyzers();
    /** The first analyzer that supports Url, in registration order; void if
        none does. */
    ::com::sun::star::code::syntax::XSyntaxAnalyzer findAnalyzer( [in] string Url );
};

}; }; }; }; };

