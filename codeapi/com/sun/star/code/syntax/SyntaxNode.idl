module com { module sun { module star { module code { module syntax {

/** One node of a parse tree: a plain struct, cheap to marshal, with the whole
    subtree in Children -- no per-node interface and no round trip per node. */
struct SyntaxNode
{
    ::com::sun::star::code::syntax::SyntaxNodeKind Kind;
    /** the name, where the node has one; empty for a statement, an expression */
    string Spelling;
    /** the parser's native kind name (for C and C++ the kind spelling
        libclang gives), for consumers that know the language */
    string DetailKind;
    /** what the node covers of the file the tree was parsed from */
    ::com::sun::star::code::core::Range Range;
    sequence< ::com::sun::star::code::syntax::SyntaxNode > Children;
};

}; }; }; }; };

