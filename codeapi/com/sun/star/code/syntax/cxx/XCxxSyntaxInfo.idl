module com { module sun { module star { module code { module syntax { module cxx {

/** What is C and C++ about an analyzer, obtained by queryInterface on an
    XSyntaxAnalyzer that lists those languages. */
interface XCxxSyntaxInfo
{
    /** The language standard Url is compiled with, as the -std= of its compile
        command spells it ("c++20", "gnu11", ...); empty where the build does
        not say. */
    string getStandard( [in] string Url );
};

}; }; }; }; }; };

