module com { module sun { module star { module code { module syntax {

/** What a syntax node is, in words every language has.  A consumer that needs
    the parser's own classification reads SyntaxNode::DetailKind instead; this
    set stays small so that a generic view (an outline, folding) need not know
    any parser. */
enum SyntaxNodeKind
{
    /** the root: the whole file */
    TRANSLATION_UNIT,
    NAMESPACE,
    CLASS,
    /** a struct, or what is nearest to one (a union, a record) */
    STRUCT,
    ENUM,
    FUNCTION,
    METHOD,
    /** a variable, field or enumerator */
    VARIABLE,
    PARAMETER,
    STATEMENT,
    EXPRESSION,
    LITERAL,
    COMMENT,
    /** a preprocessor directive, a macro definition or expansion */
    PREPROCESSOR,
    /** everything else: DetailKind says what the parser called it */
    UNKNOWN
};

}; }; }; }; };

