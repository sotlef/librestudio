module com { module sun { module star { module code { module task {

/** An entry of the problem list: a compiler error, a diagnostic, a TODO. */
struct Task
{
    /** assigned by XTaskHub::addTask(); ignored on input */
    string Identifier;
    /** what produced the task, e.g. "build", "diagnostics" */
    string Category;
    ::com::sun::star::code::core::Severity Level;
    string Description;
    /** URL of the file concerned; empty if there is none */
    string Url;
    ::com::sun::star::code::core::Position Location;
    /** a diagnostic code such as "C4101", if any */
    string Code;
    /** the tool or provider, e.g. "gcc" */
    string Source;
    /** URL of the owning project; empty if unknown */
    string Project;
};

}; }; }; }; };

