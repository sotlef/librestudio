module com { module sun { module star { module code { module task {

/** Acts on a task when the user activates it (double click in the problem
    list).  Registered with XTaskHub by a plugin.
 */
interface XTaskHandler
{
    [attribute, readonly] string Name;
    /** the categories it handles; empty means all */
    [attribute, readonly] sequence< string > Categories;

    boolean canHandle( [in] ::com::sun::star::code::task::Task Task );
    void handle( [in] ::com::sun::star::code::task::Task Task );
};

}; }; }; }; };

