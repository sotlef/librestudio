module com { module sun { module star { module code { module build {

/** Something that can be compiled on its own: a source file.  Found with
    queryInterface on the item; a file without it has no Compile command. */
interface XCompilable
{
    /** compiles it as a background job; output goes to the "build" channel
        like a build's

        @throws IOException if it cannot be compiled now */
    ::com::sun::star::code::core::XBackgroundJob compile()
        raises( ::com::sun::star::io::IOException );
};

}; }; }; }; };

