module com { module sun { module star { module code { module tool {

/** A command line, understood: what tool it is for, in what mode it runs it,
    and its arguments sorted into the tool's categories. */
struct CommandDescription
{
    string ToolId;
    string ToolName;
    /** the Id of the mode, empty if the tool has no modes */
    string Mode;
    /** only the categories in which the command sets something, in the
        order of the description */
    sequence< ::com::sun::star::code::tool::CommandCategory > Categories;
    /** the arguments the description does not know, as they were given,
        in their order */
    sequence< string > OtherArguments;
};

}; }; }; }; };

