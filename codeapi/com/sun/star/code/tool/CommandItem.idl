module com { module sun { module star { module code { module tool {

/** One argument, or one option with its value, of a command: the form in
    which a command is edited.  A list of them gives the command back. */
struct CommandItem
{
    /** the property it belongs to; empty for an argument the description does
        not know */
    string PropertyId;
    /** boolean property: "true" or "false"; enumeration: the switch;
        unknown argument: the argument itself; otherwise the option's value */
    string Value;
    /** how the value was written: "Attached" (-Ipath), "Separate" (-I path),
        "Equals" (--x=path); empty to take the property's own way */
    string Joiner;
};

}; }; }; }; };

