module com { module sun { module star { module code { module tool {

/** A tool a description is known for. */
struct ToolInfo
{
    /** the description's Id, e.g. "gcc"; what the other methods take */
    string Id;
    /** shown, e.g. "GCC / G++" */
    string Name;
    /** the revision of the description's content */
    long Revision;
};

}; }; }; }; };

