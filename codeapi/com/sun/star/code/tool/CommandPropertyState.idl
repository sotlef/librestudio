module com { module sun { module star { module code { module tool {

enum CommandPropertyState
{
    /** nothing to say */
    AVAILABLE,
    /** the property is for another mode of the tool than the command is in:
        it is recognised, and has no effect here */
    NOT_IN_MODE,
    /** the version of the tool is older than the first that has it */
    NOT_YET,
    /** the version of the tool is newer than the last that has it */
    REMOVED,
    /** the version of the tool has it, but discourages it */
    DEPRECATED
};

}; }; }; }; };

