module com { module sun { module star { module code { module refactor {

/** Where the editor finds a refactoring engine: providers register
    themselves here, and a document is routed to the one that understands
    it.  The controller routes and nothing more -- what the engine can do is
    asked of the provider itself, with queryInterface for its capability
    interfaces. */
interface XRefactoringController
{
    void registerProvider( [in] ::com::sun::star::code::refactor::XRefactoringProvider Provider );
    void unregisterProvider( [in] string Name );
    sequence< ::com::sun::star::code::refactor::XRefactoringProvider > getProviders();
    /** The first registered provider that supports the document; null if
        there is none. */
    ::com::sun::star::code::refactor::XRefactoringProvider findProvider( [in] string Url );
};

}; }; }; }; };

