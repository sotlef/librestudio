module com { module sun { module star { module code { module refactor {

/** One language's refactoring engine, registered with
    theRefactoringController.  This interface carries only identity and
    routing; what the engine can actually do is expressed by further
    capability interfaces that the object implements and that clients
    discover with queryInterface (as a vcs XRepository expresses its
    capabilities): XRenameProvider today, an XExtractFunctionProvider, an
    XExtractVariableProvider or an XChangeSignatureProvider the same way
    later, without this interface changing.  Called on the requesting
    thread; a refactoring may parse and take seconds, so an editor that must
    not block calls from a thread of its own. */
interface XRefactoringProvider
{
    string getName();
    /** lowercase language identifiers, e.g. "c", "c++" */
    sequence< string > getLanguages();
    /** whether this provider understands the document */
    boolean supports( [in] string Url );
};

}; }; }; }; };

