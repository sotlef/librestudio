module com { module sun { module star { module code { module refactor {

/** What a refactoring wants to change, over however many files.  A provider
    only describes; the editor shows the edit, applies it and owns the undo,
    so the user can look first and take it back afterwards. */
struct WorkspaceEdit
{
    sequence< ::com::sun::star::code::refactor::FileEdit > Files;
    /** one line for the user, e.g. "Rename 'foo' to 'bar' (12 occurrences
        in 3 files)" */
    string Description;
};

}; }; }; }; };

