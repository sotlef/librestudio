module com { module sun { module star { module code { module refactor {

/** All replacements of one file.  The edits are in document order and do not
    overlap, so an applier that works from the last edit to the first never
    invalidates the positions of those still to come. */
struct FileEdit
{
    string Url;
    sequence< ::com::sun::star::code::refactor::TextEdit > Edits;
};

}; }; }; }; };

