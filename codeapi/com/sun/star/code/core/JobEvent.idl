module com { module sun { module star { module code { module core {

/** Describes a change of a background job.  Source is the job.
 */
struct JobEvent : ::com::sun::star::lang::EventObject
{
    ::com::sun::star::code::core::JobStatus Status;
    /** 0..100, or -1 if the amount of work is unknown */
    short Progress;
    string Message;
};

}; }; }; }; };

