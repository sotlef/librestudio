module com { module sun { module star { module code { module core {

/** Receives status and progress changes of background jobs.

    Notifications may arrive on any thread; a UI must marshal them to its
    own thread.
 */
interface XBackgroundJobListener : ::com::sun::star::lang::XEventListener
{
    void jobChanged( [in] ::com::sun::star::code::core::JobEvent Event );
};

}; }; }; }; };

