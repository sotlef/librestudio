module com { module sun { module star { module code { module core {

/** A zero-based position in a text: line and column, the column counted in
    UTF-16 code units (the same convention as LSP and as the editor's text
    view uses).
 */
struct Position
{
    /** zero-based line */
    long Line;
    /** zero-based column, in UTF-16 code units */
    long Column;
};

}; }; }; }; };

