module com { module sun { module star { module code { module core {

/** Entry point of the IDE backend.  Deliberately thin: every subsystem is a
    singleton of its own, found through its theXxx accessor; this object only
    carries what has no home elsewhere.
 */
interface XCode
{
    [attribute, readonly] string Version;

    /** The front end (the application shell).  The shell registers itself
        here at start-up; until then, and in headless use, it is null and
        everything that would reach the user is silently skipped.
     */
    [attribute] ::com::sun::star::code::frontend::XWorkbench Workbench;

    /** Instantiates every registered com.sun.star.code.core.Plugin and activates
        it.  Idempotent.
     */
    void activatePlugins();
};

}; }; }; }; };

