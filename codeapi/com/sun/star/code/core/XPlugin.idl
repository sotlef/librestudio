module com { module sun { module star { module code { module core {

/** An IDE extension.  Implementations are registered as service
    com.sun.star.code.core.Plugin; XCode::activatePlugins() instantiates all of
    them and calls activate(), at which point a plugin attaches itself to
    the controller it extends (registers a project-format reader, an output
    filter, a task handler, ...).
 */
interface XPlugin
{
    void activate();
};

}; }; }; }; };

