module com { module sun { module star { module code { module project {

/** Writes the properties XProjectProperties marked Editable.  A capability:
    queryInterface it from the object the pages came from; an object with
    nothing to edit does not implement it.
 */
interface XProjectPropertyEditor
{
    /** Stores Value for the property Name of the page PagePath, as
        getPropertyPages spelled them.  An empty value forgets the stored
        one, so the property falls back to its default.  A page or name
        that is not editable here is refused. */
    void setProperty( [in] string PagePath, [in] string Name, [in] string Value )
        raises( ::com::sun::star::lang::IllegalArgumentException,
                ::com::sun::star::io::IOException );
};

}; }; }; }; };

