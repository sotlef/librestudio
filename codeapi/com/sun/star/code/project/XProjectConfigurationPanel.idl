module com { module sun { module star { module code { module project {

/** The panel in which the user states how a project of one format is to be
    configured.  It is an embeddable piece of user interface, not a window of
    its own: whoever shows it (today only the modal dialog of the front end)
    gives it a parent when creating it.

    Created with createInstanceWithArguments(); the arguments are named values
      ParentWindow    com.sun.star.awt.XWindow  the window to build the panel in
      ProjectUrl      string                    the project being configured
      Configurations  sequence< ProjectConfiguration >  what to start with
 */
interface XProjectConfigurationPanel
{
    /** what the panel shows now */
    [attribute, readonly] sequence< ::com::sun::star::code::project::ProjectConfiguration > Configurations;

    /** Checks the entries; returns what is wrong in words the user can act
        on, or an empty string if the configuration is acceptable. */
    string validate();
};

}; }; }; }; };

