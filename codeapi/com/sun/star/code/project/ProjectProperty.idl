module com { module sun { module star { module code { module project {

/** One row of a property page: a name and what it is set to.  A value of
    several parts (include directories, definitions) is one string with the
    parts separated by "; ", as the property pages of Visual Studio show it.
 */
struct ProjectProperty
{
    string Name;
    string Value;
    /** What the property is, for the line under the list: shown with the
        name above it, as Visual Studio does.  May be empty. */
    string Description;
    /** The value is set here, not inherited or left to the tool's default:
        the dialog shows the row in bold. */
    boolean Emphasized;
    /** The values the property can have, when it is one of a set (an
        enumeration, a yes/no): the dialog shows them in a drop-down list, to
        look at only.  Empty for a property that is free text. */
    sequence< string > Choices;
    /** Which of Choices the property has now; -1 if none. */
    long SelectedChoice;
    /** The user may change the value in the dialog.  Writing goes through
        XProjectPropertyEditor on the same object that gave the pages; a
        page's properties are read-only where this is false (the default
        for everything a build system dictates). */
    boolean Editable;
};

}; }; }; }; };

