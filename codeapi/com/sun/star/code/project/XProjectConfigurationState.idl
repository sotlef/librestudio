module com { module sun { module star { module code { module project {

/** A capability of a project whose format has to be configured: whether that
    has been done, so that the structure the configuration step produces
    (targets and their files) is available.  A project of such a format that
    is not configured yet has only its plain file tree.

    A project that implements this and changes state also implements
    ::com::sun::star::util::XModifyBroadcaster and calls its listeners when
    that happens; XProjectManager passes that on as a ProjectEvent of kind
    ITEMS_CHANGED.
 */
interface XProjectConfigurationState
{
    [attribute, readonly] boolean Configured;
};

}; }; }; }; };

