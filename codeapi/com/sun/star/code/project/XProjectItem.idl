module com { module sun { module star { module code { module project {

/** A node of the project tree. */
interface XProjectItem
{
    [attribute, readonly] string Name;
    [attribute, readonly] ::com::sun::star::code::project::ItemKind Kind;
    /** the item's file URL; empty for purely logical items */
    [attribute, readonly] string Url;
    /** null for the root item */
    [attribute, readonly] ::com::sun::star::code::project::XProjectItem Parent;
    [attribute, readonly] sequence< ::com::sun::star::code::project::XProjectItem > Children;
};

}; }; }; }; };

