module com { module sun { module star { module code { module project {

/** Capability of a project or of an item of it (a target): it can say what is
    known about it, for a properties dialog to show.  What the pages are is the
    format's own business; the dialog knows only names and values.  The pages
    are a snapshot, read-only: what a format lets the user change it changes
    through its own configuration panel.
 */
interface XProjectProperties
{
    sequence< ::com::sun::star::code::project::ProjectPropertyPage > getPropertyPages();
};

}; }; }; }; };

