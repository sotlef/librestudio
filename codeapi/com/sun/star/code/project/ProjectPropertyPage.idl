module com { module sun { module star { module code { module project {

/** One page of a properties dialog.  Path places it in the dialog's tree of
    pages: "General", "C/C++", "C/C++/Preprocessor"; the parts are separated by
    "/", and a page that has sub-pages without being listed itself is only a
    heading.
 */
struct ProjectPropertyPage
{
    string Path;
    sequence< ::com::sun::star::code::project::ProjectProperty > Properties;
};

}; }; }; }; };

