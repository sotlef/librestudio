module com { module sun { module star { module code { module project {

interface XSourceGroup : ::com::sun::star::code::project::XProjectItem
{
    /** logical path of the group inside the project, '/'-separated */
    [attribute, readonly] string GroupPath;
    /** the group's file filter as the format states it, e.g. "cpp;c;cxx";
        empty if there is none */
    [attribute, readonly] string Filter;
};

}; }; }; }; };

