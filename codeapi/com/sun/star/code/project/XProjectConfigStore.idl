module com { module sun { module star { module code { module project {

/** The configurations the user chose for projects, remembered so that a
    project that was configured once opens without asking again.  They are
    kept in a file in the project's own directory (.librestudio/), in a format
    of this IDE's own.
 */
interface XProjectConfigStore
{
    /** the remembered configurations; none at all means the project has never
        been configured */
    sequence< ::com::sun::star::code::project::ProjectConfiguration > getConfigurations( [in] string ProjectUrl );

    /** Replaces the remembered configurations.  The current one stays current
        if it is still among them. */
    void setConfigurations( [in] string ProjectUrl,
        [in] sequence< ::com::sun::star::code::project::ProjectConfiguration > Configurations )
        raises( ::com::sun::star::io::IOException );

    /** The name of the configuration the project is built in just now: the one
        last chosen, or the first if none was or the chosen one is gone.  Empty
        if the project has no configurations. */
    string getCurrentConfiguration( [in] string ProjectUrl );

    void setCurrentConfiguration( [in] string ProjectUrl, [in] string Name )
        raises( ::com::sun::star::lang::IllegalArgumentException,
                ::com::sun::star::io::IOException );

    /** Values remembered for the project as a whole, independent of any
        configuration (the startup target, for one).  Plain name/value
        strings; unknown names round-trip untouched. */
    sequence< ::com::sun::star::beans::StringPair > getProjectProperties( [in] string ProjectUrl );

    /** Replaces the project-level values.  The configurations and the
        current-configuration choice stay as they are. */
    void setProjectProperties( [in] string ProjectUrl,
        [in] sequence< ::com::sun::star::beans::StringPair > Properties )
        raises( ::com::sun::star::io::IOException );
};

}; }; }; }; };

