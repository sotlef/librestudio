module com { module sun { module star { module code { module project {

/** The configurations the user chose for projects, remembered so that a
    project that was configured once opens without asking again.  They are
    kept in a file in the project's own directory (.librestudio/), in a format
    of this IDE's own.
 */
interface XProjectConfigStore
{
    /** the remembered configurations; none at all means the project has never
        been configured */
    sequence< ::com::sun::star::code::project::ProjectConfiguration > getConfigurations( [in] string ProjectUrl );

    void setConfigurations( [in] string ProjectUrl,
        [in] sequence< ::com::sun::star::code::project::ProjectConfiguration > Configurations )
        raises( ::com::sun::star::io::IOException );
};

}; }; }; }; };

