module com { module sun { module star { module code { module project {

interface XProjectManager
{
    /** Opens a project through the reader that XProjectFormatRegistry finds;
        a directory with no matching reader is opened as a plain folder.
        Opening an already open project returns it.
     */
    ::com::sun::star::code::project::XProject openProject( [in] string Url )
        raises( ::com::sun::star::io::IOException );

    /** closes the project with this URL; does nothing if it is not open */
    void closeProject( [in] string Url );

    sequence< ::com::sun::star::code::project::XProject > getOpenProjects();
    /** null if no project with this URL is open */
    ::com::sun::star::code::project::XProject getProject( [in] string Url );

    /** null if no project is open; only an open project can be made active */
    [attribute] ::com::sun::star::code::project::XProject ActiveProject
    {
        set raises( ::com::sun::star::lang::IllegalArgumentException );
    };

    void addProjectListener( [in] ::com::sun::star::code::project::XProjectListener Listener );
    void removeProjectListener( [in] ::com::sun::star::code::project::XProjectListener Listener );
};

}; }; }; }; };

