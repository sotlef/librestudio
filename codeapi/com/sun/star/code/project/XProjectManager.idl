module com { module sun { module star { module code { module project {

interface XProjectManager
{
    /** Opens a project through the reader that XProjectFormatRegistry finds;
        a directory with no matching reader is opened as a plain folder.
        Opening an already open project returns it.

        A project of a format that has to be configured (see
        XConfigurableProjectFormat) that has never been configured is first
        configured by the user, through the front end; the answer is
        remembered in XProjectConfigStore, and the format's configuration
        step is started as a background job (its output is in an output
        channel); the project opens without waiting for it.  If the user cancels that, nothing
        is opened and null is returned.  With no front end to ask, such a
        project cannot be opened and an IOException is raised.
     */
    ::com::sun::star::code::project::XProject openProject( [in] string Url )
        raises( ::com::sun::star::io::IOException );

    /** closes the project with this URL; does nothing if it is not open */
    void closeProject( [in] string Url );

    sequence< ::com::sun::star::code::project::XProject > getOpenProjects();
    /** null if no project with this URL is open */
    ::com::sun::star::code::project::XProject getProject( [in] string Url );

    /** null if no project is open; only an open project can be made active */
    [attribute] ::com::sun::star::code::project::XProject ActiveProject
    {
        set raises( ::com::sun::star::lang::IllegalArgumentException );
    };

    /** The configurations (Debug, Release, ...) of a project that has been
        configured; none for one that has not, or that needs none. */
    sequence< ::com::sun::star::code::project::ProjectConfiguration > getConfigurations( [in] string Url );

    /** the name of the configuration that is current for the project; empty if none */
    string getCurrentConfiguration( [in] string Url );

    /** Makes another of the project's configurations current and remembers it.
        The project reads its structure again (a CMake project's targets come
        from the build directory of the current configuration), and listeners
        hear a CONFIGURATION_CHANGED event, then an ITEMS_CHANGED one.  */
    void setCurrentConfiguration( [in] string Url, [in] string Name )
        raises( ::com::sun::star::lang::IllegalArgumentException,
                ::com::sun::star::io::IOException );

    /** The name of the target of the project that runs on Start, as Visual
        Studio's startup project.  Empty when nothing sensible is stored:
        callers fall back to the first launchable target themselves.  The
        stored name is checked against the project's targets, so a target
        that is gone reads as empty. */
    string getStartupTarget( [in] string Url );

    /** Remembers TargetName as the project's startup target and tells the
        listeners with a PROPERTIES_CHANGED event.  An empty name clears the
        choice. */
    void setStartupTarget( [in] string Url, [in] string TargetName )
        raises( ::com::sun::star::lang::IllegalArgumentException,
                ::com::sun::star::io::IOException );

    void addProjectListener( [in] ::com::sun::star::code::project::XProjectListener Listener );
    void removeProjectListener( [in] ::com::sun::star::code::project::XProjectListener Listener );
};

}; }; }; }; };

