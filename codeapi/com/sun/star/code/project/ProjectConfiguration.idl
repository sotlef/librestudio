module com { module sun { module star { module code { module project {

/** One way of building a project: "Debug", "Release".  What the properties
    are is the format's own business (a CMake project has a build directory and
    a build type; an autotools one its configure arguments); the format's
    configuration panel writes them and its build code reads them.  All values
    are strings; paths are file URLs.
 */
struct ProjectConfiguration
{
    string Name;
    sequence< ::com::sun::star::beans::StringPair > Properties;
};

}; }; }; }; };

