module com { module sun { module star { module code { module project {

interface XProjectFormatRegistry
{
    /** replaces a reader of the same FormatKind */
    void registerReader( [in] ::com::sun::star::code::project::XProjectFormatReader Reader );
    void unregisterReader( [in] string FormatKind );
    sequence< ::com::sun::star::code::project::XProjectFormatReader > getReaders();
    /** the reader of the greatest priority whose canRead() accepts the URL,
        or null */
    ::com::sun::star::code::project::XProjectFormatReader findReader( [in] string Url );
};

}; }; }; }; };

