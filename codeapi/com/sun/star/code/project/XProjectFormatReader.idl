module com { module sun { module star { module code { module project {

/** Reads one project file format.  Implementations are registered with
    XProjectFormatRegistry by a plugin.
 */
interface XProjectFormatReader
{
    [attribute, readonly] string FormatKind;
    [attribute, readonly] string DisplayName;
    /** When several readers accept the same URL, the one with the greatest
        priority wins. */
    [attribute, readonly] long Priority;

    /** cheap probe: does this URL look like something this reader can read? */
    boolean canRead( [in] string Url );

    /** reads the project; the returned object implements every capability
        interface that applies */
    ::com::sun::star::code::project::XProject read( [in] string Url )
        raises( ::com::sun::star::io::IOException );
};

}; }; }; }; };

