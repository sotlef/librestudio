module com { module sun { module star { module code { module search {

interface XFindListener : ::com::sun::star::lang::XEventListener
{
    /** A search was started with XFinder::startSearch().  The listener that
        wants the results takes them from the enumeration. */
    void searchStarted( [in] ::com::sun::star::code::search::FindOptions Options,
                        [in] ::com::sun::star::code::search::XFindEnumeration Results );
};

}; }; }; }; };

