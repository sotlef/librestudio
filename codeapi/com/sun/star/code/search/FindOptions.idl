module com { module sun { module star { module code { module search {

/** What to search for and where. */
struct FindOptions
{
    string FindWhat;
    boolean MatchCase;
    boolean MatchWholeWord;
    /** FindWhat is a regular expression (ICU syntax) */
    boolean UseRegex;

    ::com::sun::star::code::search::FindScope Scope;
    /** the directory of DIRECTORY, a file URL */
    string Directory;
    /** DIRECTORY: also the directories below it */
    boolean IncludeSubfolders;
    /** the file URL of the document that CURRENT_DOCUMENT stands for */
    string DocumentUrl;
    /** the items of a project that are not part of it (EXTERNAL) */
    boolean IncludeExternal;
    /** the open documents that no project has */
    boolean IncludeMisc;
    /** file name masks separated by ";", e.g. "*.cpp;*.h"; empty or "*.*" is every file */
    string FileTypes;
    /** the results are those of Replace All: Replace says so and ReplaceWith is what the matches
        were replaced with (only the results of showResults() carry it; a search ignores it) */
    boolean Replace;
    string ReplaceWith;
};

}; }; }; }; };

