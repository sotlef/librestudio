module com { module sun { module star { module code { module search {

interface XFindEnumeration
{
    /** The search is lazy: it goes on only as far as needed to answer, so this
        reads files until one has a match, or none is left. */
    boolean hasMoreResults();

    ::com::sun::star::code::search::FindResult nextResult()
        raises( ::com::sun::star::container::NoSuchElementException );

    /** how many files were looked into until now */
    [attribute, readonly] long FilesSearched;

    /** After this there are no more results, and what is left is not read. */
    void cancel();
};

}; }; }; }; };

