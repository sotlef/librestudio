module com { module sun { module star { module code { module search {

interface XFinder
{
    /** a search of its own, nobody else hears of it
        @throws IllegalArgumentException the expression is not valid */
    ::com::sun::star::code::search::XFindEnumeration find( [in] ::com::sun::star::code::search::FindOptions Options )
        raises( ::com::sun::star::lang::IllegalArgumentException );

    /** The search that the front end shows: the same as find(), and the
        listeners are told of it.  A search that was shown before is cancelled. */
    ::com::sun::star::code::search::XFindEnumeration startSearch( [in] ::com::sun::star::code::search::FindOptions Options )
        raises( ::com::sun::star::lang::IllegalArgumentException );

    /** the enumeration of the search the front end shows now (the last
        startSearch()); null if there was none */
    [attribute, readonly] ::com::sun::star::code::search::XFindEnumeration ShownSearch;

    void addFindListener( [in] ::com::sun::star::code::search::XFindListener Listener );
    void removeFindListener( [in] ::com::sun::star::code::search::XFindListener Listener );
};

}; }; }; }; };

