module com { module sun { module star { module code { module search {

/** One matching line. */
struct FindResult
{
    string Url;
    /** where in the line the first match is (End is on the same line) */
    ::com::sun::star::code::core::Range Match;
    /** the text of the line, without its terminator */
    string LineText;
};

}; }; }; }; };

