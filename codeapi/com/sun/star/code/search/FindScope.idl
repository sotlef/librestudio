enum FindScope
{
    /** every file of every open project, and with IncludeMisc the open documents that belong to none */
    ENTIRE_SOLUTION,
    /** the files of the active project */
    CURRENT_PROJECT,
    /** the files in Directory */
    DIRECTORY,
    /** the documents that are open in the editor */
    OPEN_DOCUMENTS,
    /** the document DocumentUrl names */
    CURRENT_DOCUMENT
};

