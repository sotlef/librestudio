module com { module sun { module star { module code { module vcs {

struct BranchInfo
{
    /** the name as the system calls it */
    string Name;
    /** where it lives, if not here (a Git remote); empty for a local one */
    string Remote;
    boolean IsCurrent;
    /** what it follows, if anything */
    string Upstream;
    long Ahead;
    long Behind;
};

}; }; }; }; };

