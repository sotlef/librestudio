module com { module sun { module star { module code { module vcs {

/** Capability: the repository can list its branches.  Reading only; what
    changes them is the system's own interface. */
interface XBranchBrowser
{
    sequence< ::com::sun::star::code::vcs::BranchInfo > getBranches()
        raises( ::com::sun::star::code::vcs::VcsException );
};

