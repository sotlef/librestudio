module com { module sun { module star { module code { module vcs { module git {

/** What only a Git repository does.  The calls return when the operation is
    over, which may take long (the network): call them from a thread of your
    own.  They also run as a background job, visible and cancellable there. */
interface XGitRepository
{
    void checkout( [in] string Branch )
        raises( ::com::sun::star::code::vcs::VcsException );
    /** Creates Branch at StartPoint (empty: the current commit). */
    void createBranch( [in] string Branch, [in] string StartPoint, [in] boolean Checkout )
        raises( ::com::sun::star::code::vcs::VcsException );
    void fetch() raises( ::com::sun::star::code::vcs::VcsException );
    void pull() raises( ::com::sun::star::code::vcs::VcsException );
    void push() raises( ::com::sun::star::code::vcs::VcsException );
    /** The commits that a push would send, the newest first: those of the
        current branch that its upstream does not have, or, if it follows
        nothing yet, those that no remote branch has. */
    sequence< ::com::sun::star::code::vcs::git::CommitInfo > getOutgoingCommits()
        raises( ::com::sun::star::code::vcs::VcsException );
    sequence< string > getRemotes()
        raises( ::com::sun::star::code::vcs::VcsException );
};

}; }; }; }; }; };


