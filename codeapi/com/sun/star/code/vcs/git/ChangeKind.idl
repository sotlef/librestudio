module com { module sun { module star { module code { module vcs { module git {

/** What happened to a file, as git status says it, for the staged half and
    for the unstaged half of a FileChange separately. */
enum ChangeKind
{
    MODIFIED,
    ADDED,
    DELETED,
    RENAMED,
    COPIED,
    /** a merge conflict that is not resolved yet */
    CONFLICTED,
    /** git does not track the file */
    UNTRACKED
};

}; }; }; }; }; };

