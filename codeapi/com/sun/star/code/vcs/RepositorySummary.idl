module com { module sun { module star { module code { module vcs {

/** What a repository shows of itself in one line; every system fills it in its
    own terms, so the IDE can show any of them without knowing which it is. */
struct RepositorySummary
{
    /** the branch, "trunk r123", ...: what the status bar shows */
    string Label;
    string Tooltip;
    /** commits not yet sent / not yet received; 0 where the system has no such notion */
    long Ahead;
    long Behind;
    /** an operation is running */
    boolean Busy;
};

}; }; }; }; };

