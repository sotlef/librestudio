module com { module sun { module star { module code { module vcs {

/** One version control system, registered with theVcsManager (as the symbol
    providers are with theSymbolIndex).  Called on threads of the manager, never
    on the UI thread. */
interface XVcsProvider
{
    /** "git", ... */
    string getKind();
    /** The top directory of the working copy that holds Url (a file or a
        directory), or empty if Url is not under this system's control. */
    string findRoot( [in] string Url );
    ::com::sun::star::code::vcs::XRepository openRepository( [in] string RootUrl )
        raises( ::com::sun::star::code::vcs::VcsException );
};

}; }; }; }; };

