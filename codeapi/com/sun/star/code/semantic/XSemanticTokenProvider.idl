module com { module sun { module star { module code { module semantic {

/** The analysis side: knows a language and turns its text into tokens.  It is
    called on a thread of the controller, never on the UI thread, and may take
    its time; the controller drops a result whose Version is no longer the
    document's.  A provider is not interrupted when the document changes again
    meanwhile, so it should not be slow beyond reason. */
interface XSemanticTokenProvider
{
    string getName();
    sequence< string > getSupportedMimeTypes();
    /** Version is echoed back in the result's Version. */
    ::com::sun::star::code::semantic::SemanticTokens provideSemanticTokens(
        [in] string Url, [in] string Text, [in] long Version );
};

}; }; }; }; };

