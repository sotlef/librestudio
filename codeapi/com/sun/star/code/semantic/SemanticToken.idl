module com { module sun { module star { module code { module semantic {

/** One highlighted run of text.  A token never spans lines; a construct that
    does (a block comment) is one token per line it covers.  Column and Length
    are in UTF-16 code units, like every position of this API. */
struct SemanticToken
{
    ::com::sun::star::code::core::Position Start;
    long Length;
    ::com::sun::star::code::semantic::SemanticTokenKind Kind;
    /** a combination of SemanticTokenModifiers */
    long Modifiers;
};

}; }; }; }; };

