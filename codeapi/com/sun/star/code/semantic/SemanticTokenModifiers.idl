module com { module sun { module star { module code { module semantic {

/** Bit flags; a token carries any combination in SemanticToken::Modifiers. */
constants SemanticTokenModifiers
{
    const long DECLARATION = 1;
    const long DEFINITION = 2;
    const long READONLY = 4;
    const long STATIC = 8;
    const long DEPRECATED = 16;
    const long ABSTRACT = 32;
    const long DEFAULT_LIBRARY = 64;
};

}; }; }; }; };

