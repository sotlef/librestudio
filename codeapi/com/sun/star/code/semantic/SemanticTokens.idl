module com { module sun { module star { module code { module semantic {

/** The tokens of a whole document, as of one version of its text.  Sorted by
    position, not overlapping. */
struct SemanticTokens
{
    /** the XTextDocument::Version these tokens were computed for, or -1 if
        there are none yet */
    long Version;
    sequence< ::com::sun::star::code::semantic::SemanticToken > Tokens;
};

}; }; }; }; };

