module com { module sun { module star { module code { module output {

interface XOutputController
{
    /** the channel with this name; it is created, with this display name, if
        it does not exist yet */
    ::com::sun::star::code::output::XOutputChannel getOrCreateChannel( [in] string Name, [in] string DisplayName );
    /** null if there is no such channel */
    ::com::sun::star::code::output::XOutputChannel getChannel( [in] string Name );
    [attribute, readonly] sequence< ::com::sun::star::code::output::XOutputChannel > Channels;

    /** Every line appended to a channel is run through the applicable filters
        and the tasks they return are added to XTaskHub. */
    void registerFilter( [in] ::com::sun::star::code::output::XOutputFilter Filter );
    void unregisterFilter( [in] string Name );

    void addOutputListener( [in] ::com::sun::star::code::output::XOutputListener Listener );
    void removeOutputListener( [in] ::com::sun::star::code::output::XOutputListener Listener );
};

}; }; }; }; };

