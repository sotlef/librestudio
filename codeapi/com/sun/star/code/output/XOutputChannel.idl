module com { module sun { module star { module code { module output {

/** A named, append-only log, shown as one entry of the Output window's
    source list.  Only the most recent lines are kept.
 */
interface XOutputChannel
{
    [attribute, readonly] string Name;
    [attribute, readonly] string DisplayName;
    [attribute, readonly] long LineCount;

    void appendLine( [in] string Text, [in] ::com::sun::star::code::output::OutputStream Stream );
    void clear();
    sequence< ::com::sun::star::code::output::OutputLine > getContent();
};

}; }; }; }; };

