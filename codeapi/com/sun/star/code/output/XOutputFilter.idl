module com { module sun { module star { module code { module output {

/** Recognises structure in the lines of a channel and turns it into tasks
    (a compiler's "file:line: error: ..." into an Error List entry).
    Registered with XOutputController by a plugin.
 */
interface XOutputFilter
{
    [attribute, readonly] string Name;
    /** names of the channels it looks at; empty means all */
    [attribute, readonly] sequence< string > ApplicableChannels;

    /** the tasks the line yields, usually none or one */
    sequence< ::com::sun::star::code::task::Task > filterLine( [in] string Channel, [in] ::com::sun::star::code::output::OutputLine Line );
};

}; }; }; }; };

