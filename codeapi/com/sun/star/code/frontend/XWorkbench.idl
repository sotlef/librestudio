module com { module sun { module star { module code { module frontend {

/** What the application shell offers to the backend.  Any of the
    attributes may be null.  The shell registers it with XCode.
 */
interface XWorkbench
{
    [attribute, readonly] ::com::sun::star::code::frontend::XStatusBar StatusBar;
    [attribute, readonly] ::com::sun::star::code::frontend::XNotificationSink NotificationSink;
    [attribute, readonly] ::com::sun::star::code::frontend::XEditorHost EditorHost;
    [attribute, readonly] ::com::sun::star::code::frontend::XDialogs Dialogs;
};

}; }; }; }; };

