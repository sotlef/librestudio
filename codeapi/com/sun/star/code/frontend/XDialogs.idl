module com { module sun { module star { module code { module frontend {

interface XDialogs
{
    /** the "save changes?" question asked before a modified document closes */
    ::com::sun::star::code::frontend::SaveChoice askSaveChanges( [in] string DocumentName );
    /** lets the user pick a directory; returns its URL, or empty if cancelled */
    string pickFolder( [in] string Title );
    /** lets the user pick a file; returns its URL, or empty if cancelled */
    string pickFile( [in] string Title );
};

}; }; }; }; };

