module com { module sun { module star { module code { module frontend {

/** The editor area of the shell, as the services need it. */
interface XEditorHost
{
    /** shows the document (opening it through XDocumentManager if needed) */
    void openDocument( [in] string Url );
    /** shows the document and puts the caret at the position */
    void revealPosition( [in] string Url, [in] ::com::sun::star::code::core::Position Position );
    /** shows the document, selects the range and puts the caret at its end;
        the editor gets the focus if TakeFocus */
    /** the URL of the document of the tab that is showing; empty if there is none */
    [attribute, readonly] string CurrentDocumentUrl;
    void revealRange( [in] string Url, [in] ::com::sun::star::code::core::Range Range,
                      [in] boolean TakeFocus );
};

}; }; }; }; };

