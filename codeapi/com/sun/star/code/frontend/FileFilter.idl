module com { module sun { module star { module code { module frontend {

/** One entry of a file dialog's filter list. */
struct FileFilter
{
    /** what the user reads, e.g. "CMake projects" */
    string Title;
    /** the file names it shows, e.g. "*.sln" or "CMakeLists.txt" */
    sequence< string > Patterns;
};

}; }; }; }; };

