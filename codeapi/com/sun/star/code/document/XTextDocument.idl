module com { module sun { module star { module code { module document {

/** A document that is plain text, stored as UTF-8. */
interface XTextDocument : ::com::sun::star::code::document::XDocument
{
    [attribute] string Text;

    /** Grows with every change of the text, loading and reloading included;
        an asynchronous result computed from the text names it to
        say which text it is about. */
    [attribute, readonly] long Version;

    [attribute, readonly] long LineCount;

    /** the line without its line terminator */
    string getLine( [in] long Index )
        raises( ::com::sun::star::lang::IndexOutOfBoundsException );

    void applyEdit( [in] ::com::sun::star::code::document::TextEdit Edit )
        raises( ::com::sun::star::lang::IllegalArgumentException );
};

}; }; }; }; };

