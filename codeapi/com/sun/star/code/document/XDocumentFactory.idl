module com { module sun { module star { module code { module document {

/** Creates documents of the MIME types it supports; registered with
    XDocumentManager by a plugin.  Documents of other types are opened by the
    manager's built-in text document.
 */
interface XDocumentFactory
{
    [attribute, readonly] sequence< string > SupportedMimeTypes;

    ::com::sun::star::code::document::XDocument loadDocument( [in] string Url )
        raises( ::com::sun::star::io::IOException );
};

}; }; }; }; };

