module com { module sun { module star { module code { module document {

/** A document open in the IDE, identified by its URL. */
interface XDocument : ::com::sun::star::lang::XComponent
{
    [attribute, readonly] string Url;
    [attribute, readonly] string MimeType;
    [attribute, readonly] ::com::sun::star::code::document::DocumentState State;

    void save()
        raises( ::com::sun::star::io::IOException );
    /** discards the changes and reads the document again */
    void reload()
        raises( ::com::sun::star::io::IOException );
};

}; }; }; }; };

