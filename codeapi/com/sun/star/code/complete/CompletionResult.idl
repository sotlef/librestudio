module com { module sun { module star { module code { module complete {

/** The answer to one CompletionRequest.  The items are not filtered against
    what stands left of the caret; that is the editor's part, which filters as
    the user types on without asking again. */
struct CompletionResult
{
    sequence< ::com::sun::star::code::complete::CompletionItem > Items;
    /** true if the list was cut short, so typing on should ask again rather
        than only filter what is here */
    boolean Incomplete;
};

}; }; }; }; };

