module com { module sun { module star { module code { module complete {

/** What a proposal is.  The set follows the Language Server Protocol's, so a
    language server can feed the completion list later without translation. */
enum CompletionItemKind
{
    KEYWORD,
    TEXT,
    FUNCTION,
    METHOD,
    CONSTRUCTOR,
    FIELD,
    VARIABLE,
    CLASS,
    STRUCT,
    ENUM,
    ENUM_MEMBER,
    INTERFACE,
    MODULE,
    NAMESPACE,
    PROPERTY,
    MACRO,
    /** a whole construct with placeholders, not a single name */
    SNIPPET,
    FILE,
    FOLDER,
    UNKNOWN
};

}; }; }; }; };

