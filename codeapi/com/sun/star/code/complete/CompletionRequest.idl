module com { module sun { module star { module code { module complete {

/** What completion is asked for: a place in a document and the text as the
    editor holds it.  One request, one answer; nothing is kept between calls. */
struct CompletionRequest
{
    string Url;
    /** where the caret is, right after what was already typed */
    ::com::sun::star::code::core::Position Position;
    /** the document text as it is in the editor; empty means the file on disk */
    string Text;
    /** the character whose typing fired the request (".", ">", ":"), empty
        when the user invoked completion by hand */
    string TriggerCharacter;
};

}; }; }; }; };

