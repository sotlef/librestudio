module com { module sun { module star { module code { module debug {

/** Source is the session. */
struct DebugEvent : ::com::sun::star::lang::EventObject
{
    ::com::sun::star::code::debug::DebugEventKind Kind;
    /** the session's state after the event, whatever the Kind */
    ::com::sun::star::code::debug::DebugSessionState State;
    /** what was printed, for OUTPUT; empty otherwise */
    string Text;
    /** the thread the event is about (the one that stopped, appeared, ...);
        0 when it is about no one thread */
    long ThreadId;
};

}; }; }; }; };

