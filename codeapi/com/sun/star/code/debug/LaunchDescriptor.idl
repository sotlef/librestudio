module com { module sun { module star { module code { module debug {

/** What to debug and how to start it. */
struct LaunchDescriptor
{
    /** the program, as a file URL or a system path */
    string Program;
    /** its command line, one argument per entry, not quoted */
    sequence< string > Arguments;
    /** where it runs, as a file URL; empty for the IDE's own */
    string WorkingDirectory;
    /** "NAME=value" entries added to (or replacing in) the environment the
        program gets */
    sequence< string > Environment;
    /** stop at the program's entry before its first line runs, so that
        breakpoints can still be reached early */
    boolean StopAtEntry;
};

}; }; }; }; };

