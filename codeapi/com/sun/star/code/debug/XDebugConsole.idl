module com { module sun { module star { module code { module debug {

/** Capability: the underlying tool's own command line.  Found with
    queryInterface on the session, as XNativeDebugSession is; tool-specific
    by nature -- what the commands are and what they print is the tool's
    business (gdb's for the gdb session), and a session need not offer it
    at all. */
interface XDebugConsole
{
    /** Runs Command as the tool's own CLI would read it and returns what
        the tool printed in answer. */
    string executeCommand( [in] string Command )
        raises( ::com::sun::star::code::debug::DebugException );
};

}; }; }; }; };

