module com { module sun { module star { module code { module debug {

/** One frame of a stopped thread's call stack. */
struct StackFrame
{
    /** a handle for XDebugSession::getVariables() and evaluate(); good only
        while the program stays stopped */
    long Id;
    string FunctionName;
    /** the source file, when the backend knows it; empty otherwise */
    string Url;
    /** zero-based, as core::Position counts */
    long Line;
    /** zero-based; 0 where the backend tells no column */
    long Column;
    /** the library or module the code lives in; empty for the program itself */
    string ModuleName;
};

}; }; }; }; };

