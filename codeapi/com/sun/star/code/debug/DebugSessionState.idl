module com { module sun { module star { module code { module debug {

enum DebugSessionState
{
    /** the tool is up and the program loaded, but it does not run yet;
        breakpoints set now are there from the first line */
    STARTING,
    RUNNING,
    /** at a breakpoint, after a step, or paused */
    STOPPED,
    /** the program ended, or the session was terminated */
    EXITED
};

}; }; }; }; };

