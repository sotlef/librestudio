module com { module sun { module star { module code { module debug {

/** Capability: what only a debugger of native code has — a process to join
    by its id, flat memory to read.  Found with queryInterface on the
    session, as the Git interfaces are found on a vcs repository.  A managed
    runtime would offer what only it has (loaded assemblies, the garbage
    collector, ...) through an XManagedDebugSession the same way; that
    interface is not defined yet. */
interface XNativeDebugSession
{
    /** joins a process that already runs, instead of resume() starting one */
    void attachToProcess( [in] long Pid )
        raises( ::com::sun::star::code::debug::DebugException );
    /** Count bytes at Address, as a hex dump: two digits per byte, in
        memory order, nothing between them. */
    string readMemory( [in] hyper Address, [in] long Count )
        raises( ::com::sun::star::code::debug::DebugException );
};

}; }; }; }; };

