module com { module sun { module star { module code { module debug {

/** Hears XDebugManager::requestLaunch.  Notifications may arrive on any
    thread; a UI must marshal them to its own. */
interface XDebugManagerListener : ::com::sun::star::lang::XEventListener
{
    /** Someone asked for Descriptor to be debugged.  Whoever owns the
        debugging UI starts the session. */
    void launchRequested( [in] ::com::sun::star::code::debug::LaunchDescriptor Descriptor );
};

}; }; }; }; };

