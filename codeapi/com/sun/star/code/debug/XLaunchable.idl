module com { module sun { module star { module code { module debug {

/** Something that can be run: a capability of a project target
    (queryInterface it from an XProjectTarget).  The project model itself
    knows nothing of running; a target that cannot run (a library) either
    does not implement this or answers Launchable = false.
 */
interface XLaunchable
{
    /** false for a target that never runs (a library, a utility) */
    [attribute, readonly] boolean Launchable;

    /** The way to run the target now: the stored launch properties of the
        current configuration where the user set them, the built artifact
        and its directory where they did not.  Program is empty when no
        artifact is known.  StopAtEntry is always false here -- stopping at
        the entry point is the debug session's way of starting, not a
        property of the target; the caller sets it. */
    ::com::sun::star::code::debug::LaunchDescriptor createLaunchDescriptor();
};

}; }; }; }; };

