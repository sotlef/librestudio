module com { module sun { module star { module code { module debug {

/** Capability of an adapter (found with queryInterface on it): the exception
    filters its sessions know, with their defaults.  Asked of the adapter,
    not of a session, so that a UI can show -- and the user can set -- the
    filters before any session exists. */
interface XExceptionCatalog
{
    sequence< ::com::sun::star::code::debug::ExceptionFilter > getExceptionFilters();
};

}; }; }; }; };

