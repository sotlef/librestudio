module com { module sun { module star { module code { module debug {

/** One debugger, registered with theDebugManager (as the version control
    systems are with theVcsManager).  Makes the sessions. */
interface XDebugAdapter
{
    /** "gdb", ... */
    string getName();
    /** the languages it debugs, lowercase: "c", "c++", ... */
    sequence< string > getLanguages();
    /** whether this adapter can debug what Descriptor names, here and now:
        its tool is installed, the program is of its kind */
    boolean canDebug( [in] ::com::sun::star::code::debug::LaunchDescriptor Descriptor );
    ::com::sun::star::code::debug::XDebugSession launch(
            [in] ::com::sun::star::code::debug::LaunchDescriptor Descriptor )
        raises( ::com::sun::star::code::debug::DebugException );
};

}; }; }; }; };

