module com { module sun { module star { module code { module debug {

/** A variable, or one member of one, as the backend shows it. */
struct Variable
{
    string Name;
    /** the value rendered as text; may be empty for an aggregate */
    string Value;
    string TypeName;
    boolean HasChildren;
    /** a handle to hand back to XDebugSession::getVariables() for the
        children; 0 for a leaf.  Good only while the program stays stopped. */
    long Reference;
};

}; }; }; }; };

