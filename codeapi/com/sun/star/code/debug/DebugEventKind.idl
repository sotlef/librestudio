module com { module sun { module star { module code { module debug {

enum DebugEventKind
{
    /** the session went to another DebugSessionState */
    STATE_CHANGED,
    /** a breakpoint appeared, moved, resolved or went away; read them again
        with XDebugSession::getBreakpoints() */
    BREAKPOINT_CHANGED,
    /** the program or the tool printed Text */
    OUTPUT,
    /** a thread appeared or ended; read them again with
        XDebugSession::getThreads() */
    THREADS_CHANGED
};

}; }; }; }; };

