module com { module sun { module star { module code { module debug {

/** Capability of a session (found with queryInterface on it): which
    exception events stop the program.  Filters is the whole state, by Id;
    ones the session does not know are ignored, ones left out keep what they
    had.  Like breakpoints, this may be set while the session is STARTING. */
interface XExceptionSettings
{
    void setExceptionFilters(
            [in] sequence< ::com::sun::star::code::debug::ExceptionFilter > Filters )
        raises( ::com::sun::star::code::debug::DebugException );
};

}; }; }; }; };

