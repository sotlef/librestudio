module com { module sun { module star { module code { module debug {

/** One kind of exception event a debugger can break on ("a C++ exception is
    thrown", "a signal arrives", "a managed exception goes unhandled", ...),
    as the backend offers it.  What kinds there are is the backend's: a
    language with other exceptions has other filters. */
struct ExceptionFilter
{
    /** stable, backend-chosen, never shown ("cpp-throw") */
    string Id;
    /** what the user reads ("C++ exception thrown") */
    string Label;
    /** the program stops when this happens */
    boolean Break;
};

}; }; }; }; };

