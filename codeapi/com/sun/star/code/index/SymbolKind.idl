module com { module sun { module star { module code { module index {

/** What a symbol is.  The set follows the Language Server Protocol's, so a
    language server can feed the index later without translation. */
enum SymbolKind
{
    NAMESPACE,
    CLASS,
    STRUCT,
    UNION,
    ENUM,
    ENUM_MEMBER,
    INTERFACE,
    TYPEDEF,
    FUNCTION,
    METHOD,
    CONSTRUCTOR,
    FIELD,
    VARIABLE,
    MACRO,
    TEMPLATE_PARAMETER,
    OTHER
};

}; }; }; }; };

