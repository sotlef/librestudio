module com { module sun { module star { module code { module index {

/** Tells how a source file is compiled, so that an analyser sees the same
    macros and include paths the compiler does. */
interface XCompileCommandProvider
{
    /** The compiler arguments for Url, without the compiler and the file
        itself.  For a file the build does not name (a header) those of a
        neighbouring source file; empty if nothing is known. */
    sequence< string > getCompileArguments( [in] string Url );
};

}; }; }; }; };

