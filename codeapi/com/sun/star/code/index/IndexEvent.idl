module com { module sun { module star { module code { module index {

struct IndexEvent : ::com::sun::star::lang::EventObject
{
    ::com::sun::star::code::index::IndexState State;
    /** files indexed so far and in total, while State is INDEXING */
    long Done;
    long Total;
    /** the files whose symbols changed since the previous event */
    sequence< string > Urls;
};

}; }; }; }; };

