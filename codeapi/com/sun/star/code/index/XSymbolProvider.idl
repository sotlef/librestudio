module com { module sun { module star { module code { module index {

/** The analysis side: knows a language and finds its declarations.  It is
    called on threads of the index, never on the UI thread, and may take its
    time. */
interface XSymbolProvider
{
    string getName();
    sequence< string > getSupportedMimeTypes();
    /** The declarations of one file.  Arguments are the compiler arguments
        of XCompileCommandProvider, or empty. */
    sequence< ::com::sun::star::code::index::Symbol > extractSymbols(
        [in] string Url, [in] string Text, [in] sequence< string > Arguments );
    /** The entity the name at Position refers to (a declaration or a use of
        it); only Id and Name are required to be filled in.  Void if there is
        no name there. */
    any resolveSymbolAt( [in] string Url, [in] string Text,
        [in] sequence< string > Arguments,
        [in] ::com::sun::star::code::core::Position Position );
};

}; }; }; }; };

